# URL publique du site (sans barre oblique finale) — OBLIGATOIRE en production.
# Utilisée pour les URL canoniques, le sitemap, robots.txt, Open Graph et les données structurées.
NEXT_PUBLIC_SITE_URL=https://www.exemple.cm

# Code de vérification Google Search Console (balise meta « google-site-verification »), facultatif.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Google Analytics 4 (facultatif), ex. G-ABC123XYZ. Vide = aucune mesure d'audience.
# Chargé uniquement après accord du visiteur (bandeau de consentement).
NEXT_PUBLIC_GA_ID=

# Portail administrateur (/admin) — obligatoire pour l'activer. 12 caractères minimum,
# lettres, chiffres et tirets uniquement (pas de $, #, espaces ni guillemets).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Dossier du catalogue et des photos ajoutées depuis le portail (défaut : <projet>/.data).
# À SAUVEGARDER régulièrement : il n'est pas dans Git.
# NTK_DATA_DIR=/var/www/ntk-production/.data
